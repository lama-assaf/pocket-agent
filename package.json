{
  "name": "pocket-agent",
  "version": "6.5.3",
  "description": "Desktop AI agent with persistent memory powered by Claude Agent SDK",
  "type": "module",
  "engines": {
    "node": ">=22 <23 || >=24"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "sync-version": "node scripts/sync-version.cjs",
    "prebuild": "npm run sync-version",
    "bump-agent-sdk": "npm update @kenkaiiii/gg-agent @kenkaiiii/gg-ai @kenkaiiii/gg-core @kenkaiiii/gg-pixel @kenkaiiii/ggcoder",
    "build": "tsc && tsc -p tsconfig.preload.json && node scripts/fix-esm-imports.cjs && node scripts/copy-seed-assets.cjs",
    "start": "npm run build && npm run electron",
    "dev": "node scripts/sync-version.cjs && tsc && tsc -p tsconfig.preload.json && node scripts/fix-esm-imports.cjs && node scripts/copy-seed-assets.cjs && npm run electron",
    "watch": "tsc -w",
    "preelectron": "node scripts/check-native.cjs",
    "electron": "electron .",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build",
    "rebuild:native": "npx electron-rebuild -f -w better-sqlite3",
    "postinstall": "npx electron-rebuild -f -w better-sqlite3",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "pretest": "node scripts/check-native-node.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "eval:live": "vitest run tests/eval/live-guardrail-influence.eval.test.ts",
    "pretest:e2e": "npm run build && npx electron-rebuild -f -w better-sqlite3",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "posttest:e2e": "node scripts/check-native-node.cjs",
    "test:e2e:headed": "npm run test:e2e -- --headed",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "dist": "npm run build && electron-builder --mac",
    "dist:local": "npm run build && electron-builder --mac --config.mac.identity=null",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:local": "npm run build && electron-builder --win --config.win.forceCodeSigning=false",
    "release": "npm run build && electron-builder --mac --publish always",
    "release:win": "npm run build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.unstablemind.pocket-agent",
    "productName": "r3to.os",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "lama-assaf",
      "repo": "pocket-agent",
      "releaseType": "draft"
    },
    "mac": {
      "artifactName": "r3to.os-${version}-${arch}-mac.${ext}",
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "win": {
      "artifactName": "r3to.os-${version}-${arch}-win.${ext}",
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "r3to.os-${version}-${arch}-setup.${ext}",
      "shortcutName": "r3to.os",
      "uninstallDisplayName": "r3to.os"
    },
    "dmg": {
      "artifactName": "r3to.os-${version}-${arch}.${ext}",
      "background": "build/background.png",
      "icon": "build/icon.icns",
      "iconSize": 80,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 190
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "asar": false,
    "afterPack": "./build/afterPack.cjs",
    "afterAllArtifactBuild": "./build/afterAllArtifactBuild.cjs",
    "files": [
      "dist/**/*",
      "ui/**/*",
      "assets/**/*",
      "gg-pixel.main.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      },
      {
        "from": ".claude/",
        "to": "app/.claude/"
      },
      {
        "from": "src/marketplace/seed",
        "to": "seed-plugins",
        "filter": [
          "**/*.md",
          "**/*.json"
        ]
      },
      {
        "from": "src/clients/seeds",
        "to": "seed-clients",
        "filter": [
          "**/*.json"
        ]
      }
    ]
  },
  "author": "",
  "license": "MIT",
  "overrides": {
    "better-sqlite3": "^12.6.2",
    "adm-zip": "^0.6.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@kenkaiiii/gg-agent": "4.8.3",
    "@kenkaiiii/gg-ai": "4.8.3",
    "@kenkaiiii/gg-core": "4.8.3",
    "@kenkaiiii/gg-pixel": "4.3.101",
    "@kenkaiiii/ggcoder": "4.8.3",
    "better-sqlite3": "^12.6.2",
    "city-timezones": "^1.3.3",
    "electron-updater": "^6.8.3",
    "grammy": "^1.41.1",
    "isomorphic-git": "^1.38.6",
    "node-cron": "^4.2.1",
    "officeparser": "^7.0.3",
    "ogg-opus-decoder": "^1.7.3",
    "puppeteer-core": "^25.0.4",
    "tar": "^7.5.15",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.60.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.19",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "electron": "^41.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.0.3",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  }
}
